APP_NAME=FAStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base existente de la tienda (mae_productos, mae_marca, mae_categoria...).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=juarezc_sistema_admin
DB_USERNAME=root
DB_PASSWORD=

# Sin tablas propias de Laravel: la API es sin estado (JWT de identidad).
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log

# Tienda
TIENDA_NOMBRE=FAStore
TIENDA_URL=http://localhost:4700
# URL pública de esta API vista desde el navegador (imágenes /api/media/...).
TIENDA_API_URL=http://localhost:4700/fastore-api
TIENDA_WHATSAPP=51966422599
TIENDA_ABANDONO_HORAS=2

# Identidad central (identidad.juarezcampos.net). Sistema FASTORE registrado en el panel.
IDENTIDAD_URL=https://identidad.juarezcampos.net
IDENTIDAD_API_URL=https://identidad.juarezcampos.net/api
IDENTIDAD_CLIENT_ID=01a17035-6b8c-72e7-b44e-e353ceb723bb
IDENTIDAD_CLIENT_SECRET=
IDENTIDAD_REDIRECT_URI=https://shop.juarezcampos.net/callback
IDENTIDAD_POST_LOGOUT_URI=https://shop.juarezcampos.net/
# Roles de FASTORE que pueden entrar a la administración.
IDENTIDAD_ROLES=ADMIN,COLABORADOR

# Solo si la API está detrás de un proxy que reescribe la ruta (en cPanel se deduce sola)
IDENTIDAD_COOKIE_PATH=
